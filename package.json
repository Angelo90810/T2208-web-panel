{
  "name": "t2208-web-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:bridge": "tsc -p tsconfig.bridge.json --noEmit",
    "test:bridge": "vitest run bridge",
    "verify": "npm run typecheck && npm run typecheck:bridge && npm run test:run && npm run build",
    "bridge": "tsx bridge/index.ts",
    "bridge:sim": "tsx bridge/index.ts --simulate",
    "probe": "tsx bridge/probe.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
